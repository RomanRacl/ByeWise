rules_version = '2';
// Veškerý přístup jde přes serverové funkce na Vercelu (firebase-admin pravidla obchází).
// Přímý přístup z prohlížeče je proto úplně zakázaný.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
