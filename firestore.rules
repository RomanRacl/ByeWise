// Pravidla Firestore pro BuyWise.
// Aplikace čte a zapisuje databázi jen ze serveru (Vercel, firebase-admin), který pravidla obchází.
// Prohlížeč do databáze přímo nesmí – proto je vše zakázané. Nasazení: Firebase → Firestore → Rules → vložit → Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
